---
interface Props {
  title?: string;
}
const { title = 'AI营销文案' } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} - AI智能营销文案工具</title>
  <meta name="description" content="AI智能营销文案矩阵工具，一键生成小红书种草文、朋友圈营销文、商品详情文案、短视频脚本、SEO文章" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            dark: {
              bg: '#0d1117',
              card: '#161b22',
              border: '#30363d',
              input: '#21262d',
              hover: '#1c2128',
            },
            accent: {
              green: '#3fb950',
              blue: '#58a6ff',
              purple: '#bc8cff',
              orange: '#d29922',
            }
          }
        }
      }
    }
  </script>
  <style>
    * { box-sizing: border-box; }
    body {
      background: #0d1117;
      color: #e6edf3;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #161b22; }
    ::-webkit-scrollbar-thumb { background: #30363d; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #484f58; }
    .tab-active {
      border-bottom: 2px solid #3fb950;
      color: #3fb950;
    }
    .fade-in {
      animation: fadeIn 0.3s ease-in;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .loading-dots::after {
      content: '';
      animation: dots 1.5s steps(4, end) infinite;
    }
    @keyframes dots {
      0% { content: ''; }
      25% { content: '.'; }
      50% { content: '..'; }
      75% { content: '...'; }
    }
    .typing-cursor::after {
      content: '▊';
      animation: blink 1s step-end infinite;
      color: #3fb950;
    }
    @keyframes blink {
      50% { opacity: 0; }
    }
    textarea, input, select {
      color: #e6edf3 !important;
    }
    textarea::placeholder, input::placeholder {
      color: #6e7681 !important;
    }
    .result-content h1 { font-size: 1.5rem; font-weight: bold; margin: 1rem 0 0.5rem; color: #58a6ff; }
    .result-content h2 { font-size: 1.25rem; font-weight: bold; margin: 0.8rem 0 0.4rem; color: #3fb950; }
    .result-content h3 { font-size: 1.1rem; font-weight: bold; margin: 0.6rem 0 0.3rem; color: #bc8cff; }
    .result-content p { margin: 0.4rem 0; line-height: 1.8; }
    .result-content ul, .result-content ol { margin: 0.4rem 0; padding-left: 1.5rem; }
    .result-content li { margin: 0.2rem 0; line-height: 1.7; }
    .result-content strong { color: #3fb950; }
    .result-content table { width: 100%; border-collapse: collapse; margin: 0.8rem 0; }
    .result-content th, .result-content td { border: 1px solid #30363d; padding: 0.5rem 0.75rem; text-align: left; }
    .result-content th { background: #21262d; color: #58a6ff; font-weight: 600; }
    .result-content code { background: #21262d; padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.9em; }
    .result-content hr { border-color: #30363d; margin: 1rem 0; }
    .btn-generate {
      background: linear-gradient(135deg, #3fb950 0%, #2ea043 100%);
      transition: all 0.2s;
    }
    .btn-generate:hover {
      background: linear-gradient(135deg, #46c558 0%, #3fb950 100%);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(63, 185, 80, 0.3);
    }
    .btn-generate:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }
  </style>
</head>
<body class="min-h-screen">
  <slot />
</body>
</html>
